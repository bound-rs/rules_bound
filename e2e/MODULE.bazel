"""End-to-end tests of rules_bound, with locally built bound binaries."""

module(name = "rules_bound_e2e")

bazel_dep(name = "rules_bound")
local_path_override(
    module_name = "rules_bound",
    path = "..",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "rules_shell", version = "0.8.0")

# bound built from a checkout: this repository sits in bound's checkout
# (in CI too), whose `cargo build --release` writes target/release.
bound = use_extension("@rules_bound//bound:extensions.bzl", "bound")
bound.local(path = "../../target/release")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "e2e_pypi",
    python_version = "3.12",
    requirements_lock = "//layout:requirements.txt",
)
use_repo(pip, "e2e_pypi")
