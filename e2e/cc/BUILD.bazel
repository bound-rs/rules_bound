load("@rules_bound//bound:defs.bzl", "bound_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

cc_binary(
    name = "hello",
    srcs = ["hello.cc"],
    data = ["message.txt"],
    deps = ["@rules_cc//cc/runfiles"],
)

bound_binary(
    name = "hello_bound",
    binary = ":hello",
    bound_args = [
        "$(rlocationpath extra.txt)",
        "@args",
        "(end)",
    ],
    data = ["extra.txt"],
    visibility = ["//visibility:public"],
)
