load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@rules_bound//bound:defs.bzl", "bound_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

# A program that needs its runfiles: it prints a file it finds through the
# runfiles library, and fails without it.
cc_binary(
    name = "hello",
    srcs = ["hello.cc"],
    data = ["message.txt"],
    deps = ["@rules_cc//cc/runfiles"],
)

# The program and its runfiles as one executable, made by the default
# toolchain: the released bound binaries.
bound_binary(
    name = "hello_bound",
    binary = ":hello",
)

# That executable runs by itself, without a runfiles tree.
native_test(
    name = "hello_bound_test",
    src = ":hello_bound",
)
